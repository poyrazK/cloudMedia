# CloudMedia Local Development Environment
# Copy this file to .env and adjust values as needed.
#   cp .env.example .env

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=cloudmedia
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432

# ── Kafka (KRaft, no Zookeeper) ───────────────────────────
KAFKA_PORT=9092

# ── Redis ─────────────────────────────────────────────────
REDIS_PORT=6379
